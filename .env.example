APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OTP verification of phone numbers:
#   none     - disabled: register creates the account immediately, login by phone + password only
#   sms      - the API generates the code and sends it through SMS_DRIVER
#   firebase - the app sends the SMS with Firebase Phone Auth, the API verifies the ID token
OTP_DRIVER=none
# SMS gateway for OTP_DRIVER=sms: "log" writes messages to storage/logs/laravel.log
SMS_DRIVER=log
FIREBASE_PROJECT_ID=

# Push notifications: "fcm" sends via Firebase Cloud Messaging, "log" writes them to storage/logs/laravel.log
PUSH_DRIVER=log
# Service-account JSON key for FCM (defaults to storage/app/private/firebase-credentials.json)
# FIREBASE_CREDENTIALS=

# Token lifetimes in minutes (access: 1 day, refresh: 60 days)
SANCTUM_ACCESS_TOKEN_EXPIRATION=1440
SANCTUM_REFRESH_TOKEN_EXPIRATION=86400

# Razorpay (contributions). Webhook URL: {APP_URL}/api/v1/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Webhook events (optional; payments are also confirmed by polling): payment.captured, qr_code.credited

# Razorpay Route: pay online contributions straight to the organiser's bank. Turn on only after
# Razorpay has activated Route on the account. Online payments are disabled while this is false.
RAZORPAY_ROUTE_ENABLED=false
# Flat platform fee (₹) added to each online contribution, kept in the platform's Razorpay account
PLATFORM_FEE=2
# true only after Razorpay enables "Customer Fee Bearer" (it then adds card/netbanking charges at checkout)
RAZORPAY_CUSTOMER_FEE_BEARER=false
# Used only to show the payer an estimate of card/netbanking charges (UPI is always free)
RAZORPAY_CARD_FEE_PERCENT=2
